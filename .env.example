# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already in .gitignore.

# Your public site URL, no trailing slash. Used for canonical, sitemap and OG.
NEXT_PUBLIC_SITE_URL=https://rakibulhasan.dev

# Optional. Only needed for the contact form to actually send email.
# Get a key at https://resend.com/api-keys
# Without it, the form returns a clear "email not configured" message
# and visitors are told to email hrakibul571@gmail.com directly.
RESEND_API_KEY=

# Optional. The "from" address Resend sends from.
# Use onboarding@resend.dev for testing, or a verified domain address.
CONTACT_FROM_EMAIL=onboarding@resend.dev
